# Production image (unifood.fi): build the SolidJS app and serve dist/ statically.
# Built and pushed by .github/workflows/deploy.yml; frontend/Dockerfile stays the
# dev image used by compose.yaml (Vite dev server with HMR).
FROM node:22-bookworm-slim AS build

WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm build

FROM caddy:2-alpine
COPY --from=build /app/dist /usr/share/caddy
COPY Caddyfile.prod /etc/caddy/Caddyfile
EXPOSE 80
