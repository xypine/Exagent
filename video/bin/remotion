#!/usr/bin/env sh

set -eu

compositor_dir="$(dirname "$0")/../../node_modules/.pnpm/@remotion+compositor-linux-x64-gnu@4.0.543/node_modules/@remotion/compositor-linux-x64-gnu"
glibc_dir="$(dirname "$(cc -print-file-name=libc.so.6)")"
gcc_dir="$(dirname "$(cc -print-file-name=libgcc_s.so.1)")"
dynamic_linker="${NIX_LD:-$glibc_dir/ld-linux-x86-64.so.2}"
library_path="$compositor_dir:${NIX_LD_LIBRARY_PATH:-$glibc_dir:$gcc_dir}"

exec "$dynamic_linker" \
  --library-path "$library_path" \
  "$compositor_dir/remotion" "$@"
