# PostgreSQL (used by Docker Compose and the backend)
POSTGRES_DB=prospecting
POSTGRES_USER=prospecting
POSTGRES_PASSWORD=prospecting
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
FRONTEND_PORT=5173
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Add these only when their integrations are implemented. They are never exposed to the frontend.
EXA_API_KEY=
GEMINI_API_KEY=
