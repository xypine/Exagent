# PostgreSQL (used by Docker Compose and the backend)
POSTGRES_DB=prospecting
POSTGRES_USER=prospecting
POSTGRES_PASSWORD=prospecting
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
FRONTEND_PORT=5173
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Provider credentials are never exposed to the frontend.
EXA_API_KEY=
GEMINI_API_KEY=
MATCHING_TOP_N=5

# Outbound Exa limits
EXA_QPS=10
EXA_MAX_CONCURRENCY=5
EXA_TIMEOUT_SECONDS=30
EXA_MAX_RETRIES=3
EXA_RETRY_BASE_SECONDS=0.5
EXA_RETRY_MAX_SECONDS=10
EXA_MAX_QUEUE_WAIT_SECONDS=30
EXA_MAX_PENDING_REQUESTS=25
PEOPLE_SEARCH_CONCURRENCY=4

# Company discovery
COMPANY_SEARCH_INITIAL_RESULTS=15
COMPANY_SEARCH_MAX_RESULTS=50
COMPANY_SEARCH_CACHE_TTL_SECONDS=86400
